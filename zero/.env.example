# Banco de dados local (MySQL)
DB_URL=jdbc:mysql://localhost:3306/system_rpg
DB_USERNAME=root
DB_PASSWORD=sua_senha_aqui

# Exemplo para banco gerenciado com TLS (ex.: TiDB Cloud / MySQL Cloud):
# DB_URL=jdbc:mysql://seu-cluster.tidbcloud.com:4000/system_rpg?useSSL=true&requireSSL=true&serverTimezone=UTC
# DB_USERNAME=seu_usuario_cluster

# Configurações SMTP (notificações e recuperação por e-mail)
SMTP_EMAIL=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app_gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# CORS e porta da aplicação
ALLOWED_ORIGINS=http://localhost:4000
PORT=4000
